{
  "name": "oas-demo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "generate": "openapi-generator-cli generate -i ../oas/openapi.yaml -g typescript-fetch -o src/generated --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "test": "vitest run"
  },
  "dependencies": {
    "keycloak-js": "^26.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.0.0"
  }
}
